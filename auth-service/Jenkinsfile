pipeline {
  agent any

  tools {
    nodejs 'node-20'
  }

  environment {
    imageName = 'sanketdesai09/auth-service'
    scannerHome = tool 'sonar-scanner'
    dcHome = tool 'OWASP-DC'
    DOCKER_CREDS = credentials('dockerhub-creds')
    GITHUB_TOKEN = credentials('github-token')
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Install Dependencies') {
      steps {
        dir('auth-service') {
          sh 'npm ci'
        }
      }
    }

    stage('Set image tag') {
            steps {
                script {
                    env.IMAGE_TAG = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()
                }
                echo "Using image tag: ${IMAGE_TAG}"
            }
        }
      
    stage('Static Code Analysis - SonarQube') {
      steps {
        dir('auth-service') {
          withSonarQubeEnv('sonarqube') {
              sh """
              ${scannerHome}/bin/sonar-scanner \
              -Dsonar.projectName=auth-service \
              -Dsonar.projectKey=auth-service \
              -Dsonar.sources=.
              """
          }
        }
      }
    }

    stage('Dependency Scan - OWASP') {
      steps {
        dir('auth-service') {
          sh """
            ${dcHome}/bin/dependency-check.sh \
              --project auth-service \
              --scan . \
              --format XML \
              --out dependency-check-report \
              --disableAssembly \
              --disableYarnAudit
          """
        }
      }
    }

    stage('Docker Build') {
      steps {
        dir('auth-service'){
            sh """
              commitHash=\$(git rev-parse --short HEAD)

              docker build -t ${imageName}:\$commitHash .
              docker tag ${imageName}:\$commitHash ${imageName}:latest
            """
          }
        }
      }

    stage('Image Scan - Trivy') {
      steps {
        sh """
          docker run --rm \
            -v /var/run/docker.sock:/var/run/docker.sock \
            -v \$HOME/.cache/trivy:/root/.cache/trivy \
            aquasec/trivy:latest \
            image --severity HIGH,CRITICAL --exit-code 0 \
            --format table \
            $imageName:latest
        """
      }
    }

    stage('push image to dockerhub') {
      when {
        branch 'main'
      }
      steps {
        sh """
        echo "$DOCKER_CREDS_PSW" | docker login -u "$DOCKER_CREDS_USR" --password-stdin
        docker push ${imageName}:${IMAGE_TAG}
        docker push ${imageName}:latest
        """
      }
    }

    stage('Update GitOps manifests repo') {
      when { branch 'main' }
      steps {
        withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
            sh '''
            rm -rf shop-platform-gitops

            git clone https://x-access-token:$GITHUB_TOKEN@github.com/dev-sd092/shop-platform-gitops.git
            cd shop-platform-gitops

            sed -i "s|image: .*product-service:.*|image: sanketdesai09/auth-service:${IMAGE_TAG}|g" environments/dev/auth-service.yaml

            git config user.name "jenkins"
            git config user.email "jenkins@ci.local"

            git add environments/dev/auth-service.yaml
            git commit -m "Update auth service image to ${IMAGE_TAG}" || echo "No changes to commit"
            git push origin main
            '''
        }
      }
    }
  }
}
