pipeline {
    agent any

    tools {
        nodejs 'node-20'
    }

    environment {
        sonarHome = tool 'sonar-scanner'
        imageName = 'sanketdesai09/frontend'
        DOCKER_CREDS = credentials('dockerhub-creds')
    }

    stages {

        stage('clean workspace') {
            steps {
                cleanWs()
            }
        }

        stage('checkout code') {
            steps {
                checkout scm
            }
        }

        stage('install dependencies') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                }
            }
        }

        stage('sonarqube analysis') {
            steps {
                dir('frontend') {
                    withSonarQubeEnv('sonarqube') {
                        sh """
                        ${sonarHome}/bin/sonar-scanner \
                        -Dsonar.projectKey=frontend \
                        -Dsonar.projectName=frontend \
                        -Dsonar.sources=.
                        """
                    }
                }
            }
        }

        stage('docker build (with env injection)') {
            steps {
                dir('frontend') {
                    sh """
                    commitHash=\$(git rev-parse --short HEAD)

                    docker build \
                      --build-arg VITE_AUTH_API=http://auth-service:4000 \
                      --build-arg VITE_PRODUCT_API=http://product-service:5000 \
                      --build-arg VITE_CART_API=http://cart-service:6001 \
                      --build-arg VITE_ORDER_API=http://order-service:7000 \
                      -t ${imageName}:\$commitHash .

                    docker tag ${imageName}:\$commitHash ${imageName}:latest
                    """
                }
            }
        }

        stage('trivy image scan') {
            steps {
                sh """
                docker run --rm \
                  -v /var/run/docker.sock:/var/run/docker.sock \
                  -v \$HOME/.cache/trivy:/root/.cache/trivy \
                  aquasec/trivy:latest \
                  image --severity HIGH,CRITICAL --exit-code 0 \
                  --format table \
                  ${imageName}:latest
                """
            }
        }

        stage('push image to dockerhub') {
            when {
                branch 'main'
            }
            steps {
                sh """
                echo "$DOCKER_CREDS_PSW" | docker login -u "$DOCKER_CREDS_USR" --password-stdin
                docker push ${imageName}:latest
                """
            }
        }
    }
}
